# Reown Cloud project ID used by the wallet modal.
VITE_REOWN_PROJECT_ID=

# Public score endpoint. Sepolia uses the deployed API Gateway's /score/{address} route.
VITE_SCORE_API_URL=https://j9j79vdvkj.execute-api.eu-central-1.amazonaws.com

# Public claim job API used to ask the Nitro enclave for first-claim incident authorization.
VITE_CLAIM_API_URL=

# Temporary Morpho vault used for the live APY and Go to Morpho link.
VITE_MORPHO_VAULT_ADDRESS=0xBEEF01735c132Ada46AA9aA4c54623cAA92A64CB

# Optional public Sepolia RPC override.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Browser-restricted dRPC endpoint for Ethereum mainnet. PublicNode remains the emergency fallback.
VITE_MAINNET_RPC_URL=

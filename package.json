{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "./deploy.sh",
    "score-api:dev": "npx wrangler dev --config worker/wrangler.toml",

{"Version":"2012-10-17","Statement":[
 {"Sid":"ReadFleet","Effect":"Allow","Action":["ec2:DescribeInstances","ec2:DescribeImages"],"Resource":"*"},
 {"Sid":"ReadConfigs","Effect":"Allow","Action":"lambda:GetFunctionConfiguration","Resource":["arn:aws:lambda:eu-central-1:<AWS_ACCOUNT_ID>:function:usd8-tee-job-api","arn:aws:lambda:eu-central-1:<AWS_ACCOUNT_ID>:function:usd8-tee-janitor"]},
 {"Sid":"ReadJanitorRule","Effect":"Allow","Action":"events:DescribeRule","Resource":"arn:aws:events:eu-central-1:<AWS_ACCOUNT_ID>:rule/usd8-tee-janitor"},
 {"Sid":"ReadJobApiAllowlist","Effect":"Allow","Action":"iam:GetRolePolicy","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/USD8TeeLambdaRole"},
 {"Sid":"ReadMetrics","Effect":"Allow","Action":"cloudwatch:GetMetricStatistics","Resource":"*"},
 {"Sid":"Logs","Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],"Resource":"arn:aws:logs:eu-central-1:<AWS_ACCOUNT_ID>:log-group:/aws/lambda/usd8-tee-status*"}]}
